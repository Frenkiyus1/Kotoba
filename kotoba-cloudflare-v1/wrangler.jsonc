{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "kobota",

  "account_id": "dba6ca6525fb5cc77b5b30c35cd9840e",

  "main": "src/index.js",

  "compatibility_date": "2026-10-05",

  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8"
  },

  "ai": {
    "binding": "AI"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kotoba-db",
      "database_id": "e12223a8-cb42-4dda-b6f1-f2d832566ab8"
    }
  ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
