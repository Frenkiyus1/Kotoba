{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "kobota",

  "account_id": "dba6ca6525fb5cc77b5b30c35cd9840e",

  "main": "src/index.js",

  "compatibility_date": "2026-10-05",

  "ai": {
    "binding": "AI"
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
