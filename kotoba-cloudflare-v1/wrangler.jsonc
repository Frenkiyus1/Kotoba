{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "kobota",

  "main": "src/index.js",

  "compatibility_date": "2026-10-05",

  // =========================================================
  // CLOUDFLARE WORKERS AI
  // Backend sử dụng bằng env.AI
  // =========================================================
  "ai": {
    "binding": "AI"
  },

  // =========================================================
  // CLOUDFLARE D1 DATABASE
  // Backend sử dụng bằng env.DB
  // GIỮ database_id thật của bạn
  // =========================================================
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kotoba-db",
      "database_id": "DATABASE_ID_CỦA_BẠN"
    }
  ],

  // =========================================================
  // STATIC FRONTEND
  // =========================================================
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",

    // Chỉ API mới cần chạy backend trước
    "run_worker_first": [
      "/api/*"
    ]
  }
}
